{
  "name": "Production database schema mismatch",
  "detectorIds": [
    "<issue-stream-monitor-id>"
  ],
  "triggers": {
    "logicType": "any-short",
    "conditions": [
      {
        "type": "first_seen_event",
        "comparison": true,
        "conditionResult": true
      },
      {
        "type": "regression_event",
        "comparison": true,
        "conditionResult": true
      },
      {
        "type": "event_frequency_count",
        "comparison": {
          "value": 0,
          "interval": "1m"
        },
        "conditionResult": true
      }
    ],
    "actions": []
  },
  "environment": "production",
  "actionFilters": [
    {
      "logicType": "all",
      "conditions": [
        {
          "type": "tagged_event",
          "comparison": {
            "key": "failure_kind",
            "match": "eq",
            "value": "schema_drift"
          },
          "conditionResult": true
        }
      ],
      "actions": [
        {
          "type": "email",
          "integrationId": null,
          "data": {
            "fallthroughType": "ActiveMembers"
          },
          "config": {
            "targetType": "issue_owners",
            "targetDisplay": null,
            "targetIdentifier": null
          },
          "status": "active"
        }
      ]
    }
  ],
  "config": {
    "frequency": 5
  },
  "enabled": true
}
