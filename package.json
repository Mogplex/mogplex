{
  "name": "mogplex",
  "version": "0.1.0",
  "description": "Browser-native workspace for running AI agents against real repositories",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "homepage": "https://github.com/webrenew/mogplex#readme",
  "bugs": {
    "url": "https://github.com/webrenew/mogplex/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webrenew/mogplex.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node --max-old-space-size=6144 ./node_modules/eslint/bin/eslint.js --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content --concurrency auto .",
    "lint:fix": "node --max-old-space-size=6144 ./node_modules/eslint/bin/eslint.js --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content --concurrency auto --fix .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "harness:check": "node scripts/sync-harness-configs.mjs --check",
    "harness:sync": "node scripts/sync-harness-configs.mjs --write",
    "harness:smoke": "tsx scripts/harness-smoke-test.ts",
    "mcp:smoke": "tsx scripts/smoke-mogplex-mcp.ts",
    "quality:pr-review": "tsx scripts/run-pr-review-candidate.ts",
    "git:cleanup": "pnpm exec tsx scripts/post-merge-cleanup.ts",
    "billing:capacity-catalog": "pnpm exec tsx scripts/seed-capacity-stripe-catalog.ts",
    "billing:capacity-test-clock": "pnpm exec tsx scripts/run-capacity-stripe-test-clock.ts",
    "trigger:dev": "pnpm exec tsx scripts/trigger-cli.ts dev",
    "trigger:deploy": "pnpm exec tsx scripts/trigger-cli.ts deploy",
    "email:dev": "email dev --dir emails --port 3030",
    "test:unit": "tsx --require ./tests/support/bundler-shims.cjs --test tests/unit/*.test.ts",
    "test:db": "vitest run -c vitest-db.config.ts",
    "test:all": "pnpm test && pnpm test:unit && pnpm test:db",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "pnpm exec eslint --fix",
      "bash -c 'pnpm exec tsc --noEmit --pretty false'"
    ]
  },
