# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (required)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Inth/c15t consent backend (optional - enables hosted cookie consent records)
# When unset, the banner uses c15t offline mode for local-only consent storage.
NEXT_PUBLIC_C15T_URL=https://your-project.inth.app

# CLI install scripts and release metadata are served from the canonical
# R2 origin at https://install.mogplex.com. No local env vars are required.

# Cron job authentication (required for cron routes and machine-only workflow starter routes)
CRON_SECRET=your-cron-secret

# Internal delegated API authentication (required for server-to-server sandbox actions)
INTERNAL_API_SECRET=your-internal-api-secret

# Public Mogplex API / MCP (optional)
# Override self-calls when the canonical app URL is not the desired API host.
MOGPLEX_API_URL=http://127.0.0.1:3000
# Canonical OAuth protected resource. Production defaults to APP_URL + the MCP
# path; set this explicitly when testing OAuth against a different deployment.
MOGPLEX_MCP_RESOURCE_URL=http://127.0.0.1:3000/api/v1/mogplex/mcp
# Comma-separated browser origins allowed to call the MCP endpoint. Local
# server-to-server MCP clients normally omit Origin and do not need this.
MOGPLEX_MCP_ALLOWED_ORIGINS=

# Vercel OAuth (optional — enables "Sign in with Vercel")
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=your-vercel-client-id
VERCEL_APP_CLIENT_SECRET=your-vercel-client-secret

# GitHub App (optional — required for installation-backed repo access and webhooks)
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_NAME=your-github-app-name
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# Platform access bootstrap allowlists (optional)
PLATFORM_ACCESS_USER_IDS=
PLATFORM_ACCESS_EMAILS=
PLATFORM_ACCESS_EMAIL_DOMAINS=

# Platform-managed sandboxes (optional — required for Mogplex-managed sandbox billing locally)
PLATFORM_VERCEL_TOKEN=your-platform-vercel-token
PLATFORM_VERCEL_TEAM_ID=your-platform-vercel-team-id
VERCEL_PROJECT_ID=your-platform-vercel-project-id

# Platform AI and memory context (optional)
AI_GATEWAY_API_KEY=your-ai-gateway-api-key
# Optional automation prompt-caching control. Defaults to auto when unset; set
# to off to disable Gateway/Anthropic prompt caching for automation jobs.
# AUTOMATION_GATEWAY_CACHING=off
# Optional comma-separated automation model fallback preferences. Entries are
# normalized, validated, deduplicated, and capped; invalid-only values use the
# safe defaults shown below. Team capability and model allowlist policies still
# apply before a fallback is sent to AI Gateway.
# AUTOMATION_GATEWAY_FALLBACK_MODELS=zai/glm-5.2-fast,openai/gpt-5.4
# Optional for authenticated OpenRouter model catalog sync; users can also
# store their own OpenRouter key in Settings > API Keys for inference.
OPENROUTER_API_KEY=your-openrouter-api-key
# Used for embedding memory content for semantic search in /api/memories.
# If omitted, memories still store/list/delete but search falls back to ILIKE.
OPENAI_API_KEY=your-openai-api-key

# Trigger.dev (optional — required if you want local Trigger-powered jobs instead of just fallback routes)
TRIGGER_PROJECT_REF=proj_yourprojectref
TRIGGER_SECRET_KEY=tr_dev_your_trigger_secret

# Sandbox cost estimate rate (optional — cents per compute-second, default 0.0028).
# Used only for unit-economics telemetry on the sandboxes.cost_cents_estimate column.
# PLATFORM_SANDBOX_COST_CENTS_PER_SECOND=0.0028

# GitHub OAuth (optional — enables "Sign in with GitHub" via Supabase Auth)
# Configure in Supabase Dashboard > Authentication > Providers > GitHub

# Connection encryption key (required for encrypted API credentials)
CONNECTIONS_ENCRYPTION_KEY=your-32-byte-hex-key

# Pipedream Connect (optional — required for Sentry managed OAuth connections)
PIPEDREAM_CLIENT_ID=your-pipedream-client-id
PIPEDREAM_CLIENT_SECRET=your-pipedream-client-secret
PIPEDREAM_PROJECT_ID=proj_your_pipedream_project_id
PIPEDREAM_PROJECT_ENVIRONMENT=development
PIPEDREAM_CONNECT_WEBHOOK_SIGNING_KEY=your-pipedream-webhook-signing-key
# Optional override if your Connect project uses a non-default Sentry app slug
PIPEDREAM_SENTRY_APP_SLUG=sentry

# Sentry (optional — enables error tracking and performance monitoring)
# Public DSN shared with the browser runtime
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Server-only DSN (defaults to NEXT_PUBLIC_SENTRY_DSN when unset)
SENTRY_DSN=
# Source map upload credentials (required only in CI/production builds)
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
SENTRY_AUTH_TOKEN=your-sentry-auth-token
# Optional sampling/environment overrides
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1

# Slack bot (optional — enables the Mogplex Slack app and multi-workspace OAuth distribution)
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_SIGNING_SECRET=your-slack-signing-secret
# Optional override; defaults to ${NEXT_PUBLIC_APP_URL}/api/integrations/slack/callback
SLACK_REDIRECT_URI=

# Waitlist replacement-code email (optional)
# When unset, /api/auth/waitlist/new-code logs the minted code to stderr
# (look in Vercel logs for "waitlist_replacement_code_pending_delivery") so
# you can hand-deliver it. Set RESEND_API_KEY to enable automatic email.
RESEND_API_KEY=
WAITLIST_FROM_EMAIL="Mogplex <noreply@mogplex.com>"

# Email unsubscribe link signing secret.
# HMAC-SHA256 key used to mint and verify /unsubscribe links and the RFC 8058
# /api/unsubscribe one-click endpoint. Required in production (the app
# throws if unset and NODE_ENV=production). Rotating this value invalidates
# every outstanding unsubscribe link.
EMAIL_UNSUBSCRIBE_SECRET=replace-with-a-32-byte-random-string

# --- better-auth (Neon-backed browser and MCP OAuth authentication) ---
# Postgres connection for better-auth (Neon). Unset = auth and OAuth routes
# return errors at request time; env-less builds can still import the modules.
DATABASE_URL=
# Session/token signing secret. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional explicit base URL; defaults to NEXT_PUBLIC_APP_URL.
BETTER_AUTH_URL=
# Better Auth dashboard project key (better-auth.com) — optional. Powers the
# dash() plugin (cloud dashboard ownership verification + remote admin); must
# be set in the deployed environment for the dashboard to connect.
BETTER_AUTH_API_KEY=
# Social sign-in (each provider activates only when both values are set).
# Callback URLs to register with each provider:
#   GitHub:    ${NEXT_PUBLIC_APP_URL}/api/auth/callback/github
#   Google:    ${NEXT_PUBLIC_APP_URL}/api/auth/callback/google
#   Microsoft: ${NEXT_PUBLIC_APP_URL}/api/auth/callback/microsoft
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
# Entra tenant; "common" allows any Microsoft account.
AUTH_MICROSOFT_TENANT_ID=common
# From-address for verification/reset emails; falls back to WAITLIST_FROM_EMAIL.
AUTH_FROM_EMAIL=
