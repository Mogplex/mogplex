# Application backend: Neon Postgres + Better Auth (connection settings below).
# Both switches must agree; NEXT_PUBLIC_* is baked in at build time.
MOGPLEX_DATA_BACKEND=neon
NEXT_PUBLIC_MOGPLEX_DATA_BACKEND=neon

# Legacy Supabase deployments only: switch both backend flags to supabase.
# Leave these empty for Neon. Do not add dummy keys to hide initialization bugs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional server-side aliases: SUPABASE_URL is preferred over the public URL
# for the admin client; SUPABASE_SECRET_KEY is the newer name for the service key.
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=

# App URL (required)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional server-side app URL, read before NEXT_PUBLIC_APP_URL (lib/app-url.ts).
# APP_URL=
# Optional origin for links in outgoing email; falls back to NEXT_PUBLIC_APP_URL.
# NEXT_PUBLIC_SITE_URL=

# Inth/c15t consent backend (optional - enables hosted cookie consent records)
# When unset, the banner uses c15t offline mode for local-only consent storage.
NEXT_PUBLIC_C15T_URL=https://your-project.inth.app

# CLI install scripts and release metadata are served from the canonical
# R2 origin at https://install.mogplex.com. No local env vars are required.

# Cron job authentication (required for cron routes and machine-only workflow starter routes)
CRON_SECRET=your-cron-secret

# Stripe billing (optional). Capacity operations require the first switch.
# A live secret key also requires the second switch so live Checkout and
# catalog writes can be rolled back without disabling legacy billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CAPACITY_BILLING_OPERATIONS_ENABLED=false
CAPACITY_BILLING_LIVE_WRITES_ENABLED=false
# Comma-separated billing_accounts.id values allowed to buy reserved
# concurrency while the product is in its GTM pilot.
CAPACITY_BILLING_PILOT_ACCOUNT_IDS=

# Internal delegated API authentication (required for server-to-server sandbox actions)
INTERNAL_API_SECRET=your-internal-api-secret

# Public Mogplex API / MCP (optional)
# Override self-calls when the canonical app URL is not the desired API host.
MOGPLEX_API_URL=http://127.0.0.1:3000
# Canonical OAuth protected resource. Production defaults to APP_URL + the MCP
# path; set this explicitly when testing OAuth against a different deployment.
MOGPLEX_MCP_RESOURCE_URL=http://127.0.0.1:3000/api/v1/mogplex/mcp
# Comma-separated browser origins allowed to call the MCP endpoint. Local
# server-to-server MCP clients normally omit Origin and do not need this.
MOGPLEX_MCP_ALLOWED_ORIGINS=

# Vercel OAuth (optional — enables "Sign in with Vercel")
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=your-vercel-client-id
VERCEL_APP_CLIENT_SECRET=your-vercel-client-secret

# GitHub App (optional — required for installation-backed repo access and webhooks)
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_NAME=your-github-app-name
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# GitHub OAuth app (optional — repo listing/import and the reauthorize flow that
# refreshes token scopes). Callback: ${NEXT_PUBLIC_APP_URL}/api/auth/github/callback
# Separate from AUTH_GITHUB_* below, which is sign-in only.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Platform access bootstrap allowlists (optional)
PLATFORM_ACCESS_USER_IDS=
PLATFORM_ACCESS_EMAILS=
PLATFORM_ACCESS_EMAIL_DOMAINS=

# Platform-managed sandboxes (optional — required for Mogplex-managed sandbox billing locally)
PLATFORM_VERCEL_TOKEN=your-platform-vercel-token
PLATFORM_VERCEL_TEAM_ID=your-platform-vercel-team-id
VERCEL_PROJECT_ID=your-platform-vercel-project-id
PLATFORM_VERCEL_PROJECT_ID=your-platform-vercel-project-id
# Aliases that pnpm trigger:* reads (before the PLATFORM_* values) to sync
# Vercel env vars into Trigger.dev deploys.
# VERCEL_ACCESS_TOKEN=
# VERCEL_TEAM_ID=
# Optional sandbox behavior switches.
# Queue a snapshot warmup when a sandbox launches (truthy to enable).
# ENABLE_SANDBOX_SNAPSHOT_WARMUP=1
# Reserve the in-sandbox PTY terminal bridge port (truthy to enable).
# MOGPLEX_TERMINAL_PTY=1
# Auto-pause idle sandboxes: observe (default), enabled, or internal (only the
# comma-separated user IDs in SANDBOX_AUTO_PAUSE_INTERNAL_USER_IDS).
# SANDBOX_AUTO_PAUSE_MODE=observe
# SANDBOX_AUTO_PAUSE_INTERNAL_USER_IDS=
# SANDBOX_AUTO_PAUSE_GRACE_PERIOD_MS=
# Baseline snapshot reaper thresholds, in days (defaults 14 and 30).
# SNAPSHOT_MAX_AGE_DAYS=14
# SNAPSHOT_IDLE_DAYS=30

# Platform AI and memory context (optional)
AI_GATEWAY_API_KEY=your-ai-gateway-api-key
# Shared agent web search and page extraction; provisioned by the Exa Vercel integration.
# Keep server-side. Workers without a readable key use the EXA_RESEARCH_SECRET relay.
EXA_API_KEY=your-exa-api-key
# Shared by Vercel and Trigger; use encrypted (exportable) for worker env sync.
EXA_RESEARCH_SECRET=your-research-service-secret
# Optional decision layer overrides (see docs/decisions.md). The layer uses the
# gateway credential above and stays inactive without one.
# DECISION_MODES={"command_risk.agent_tool":"enforce"}
# DECISIONS_DISABLED=1
# Evaluation model overrides for the decision layer and PR review rewrites.
# DECISION_MODEL=
# DECISION_ESCALATION_MODEL=
# PR_REVIEW_REWRITE_MODEL=
# Optional automation prompt-caching control. Defaults to auto when unset; set
# to off to disable Gateway/Anthropic prompt caching for automation jobs.
# AUTOMATION_GATEWAY_CACHING=off
# Optional comma-separated automation model fallback preferences. Entries are
# normalized, validated, deduplicated, and capped; invalid-only values use the
# safe defaults shown below. Team capability and model allowlist policies still
# apply before a fallback is sent to AI Gateway.
# AUTOMATION_GATEWAY_FALLBACK_MODELS=zai/glm-5.2-fast,openai/gpt-5.4
# Optional for authenticated OpenRouter model catalog sync; users can also
# store their own OpenRouter key in Settings > API Keys for inference.
OPENROUTER_API_KEY=your-openrouter-api-key
# Used for embedding memory content for semantic search in /api/memories.
# If omitted, memories still store/list/delete but search falls back to ILIKE.
OPENAI_API_KEY=your-openai-api-key
# Set to off to run every sandbox harness through its one-shot CLI instead of
# the Agent Client Protocol bridge (docs/harness-acp.md).
# MOGPLEX_HARNESS_ACP=off

# Trigger.dev (optional — required if you want local Trigger-powered jobs instead of just fallback routes)
# Self-hosted Trigger.dev instance URL (default https://api.trigger.dev).
# TRIGGER_API_URL=
TRIGGER_PROJECT_REF=proj_yourprojectref
TRIGGER_SECRET_KEY=tr_dev_your_trigger_secret
# Alternative credential the SDK accepts instead of TRIGGER_SECRET_KEY.
# TRIGGER_ACCESS_TOKEN=
# Extra comma-separated env files for pnpm trigger:* (after .env and .env.local).
# TRIGGER_CLI_ENV_FILES=

# Sandbox cost estimate rate (optional — cents per compute-second, default 0.0028).
# Used only for unit-economics telemetry on the sandboxes.cost_cents_estimate column.
# PLATFORM_SANDBOX_COST_CENTS_PER_SECOND=0.0028

# Connection encryption key (required for encrypted API credentials)
CONNECTIONS_ENCRYPTION_KEY=your-32-byte-hex-key

# Sentry (optional — enables error tracking and performance monitoring)
# Public DSN shared with the browser runtime
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Server-only DSN (defaults to NEXT_PUBLIC_SENTRY_DSN when unset)
SENTRY_DSN=
# Source map upload credentials (required only in CI/production builds)
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
SENTRY_AUTH_TOKEN=your-sentry-auth-token
# Optional sampling/environment overrides
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1
# Browser environment tag; defaults to the Vercel environment.
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Release tag for schema-drift reports when no deploy commit is available.
# SENTRY_RELEASE=

# Slack bot (optional — enables the Mogplex Slack app and multi-workspace OAuth distribution)
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_SIGNING_SECRET=your-slack-signing-secret
# Optional override; defaults to ${NEXT_PUBLIC_APP_URL}/api/integrations/slack/callback
SLACK_REDIRECT_URI=

# Waitlist replacement-code email (optional)
# When unset, /api/auth/waitlist/new-code logs the minted code to stderr
# (look in Vercel logs for "waitlist_replacement_code_pending_delivery") so
# you can hand-deliver it. Set RESEND_API_KEY to enable automatic email.
RESEND_API_KEY=
WAITLIST_FROM_EMAIL="Mogplex <noreply@mogplex.com>"
# From-address for team invites; falls back to WAITLIST_FROM_EMAIL.
# TEAM_INVITE_FROM_EMAIL=
# Signs the legacy waitlist access cookie; falls back to the Supabase service key.
# WAITLIST_COOKIE_SECRET=

# Email unsubscribe link signing secret.
# HMAC-SHA256 key used to mint and verify /unsubscribe links and the RFC 8058
# /api/unsubscribe one-click endpoint. Required in production (the app
# throws if unset and NODE_ENV=production). Rotating this value invalidates
# every outstanding unsubscribe link.
EMAIL_UNSUBSCRIBE_SECRET=replace-with-a-32-byte-random-string

# --- better-auth (Neon-backed browser and MCP OAuth authentication) ---
# Preferred hosted runtime connections. These must connect directly as the
# service_role hardened by the Neon runtime migration; it can perform serving
# DML but cannot create databases, roles, or schema objects. The direct URL is
# required by pg LISTEN clients.
MOGPLEX_RUNTIME_DATABASE_URL=
MOGPLEX_RUNTIME_DATABASE_URL_UNPOOLED=
# Local/CI fallback and owner connection used by migration tooling. Unset =
# auth and OAuth routes return errors at request time; env-less builds can
# still import the modules.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Session/token signing secret. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional explicit base URL; defaults to NEXT_PUBLIC_APP_URL.
BETTER_AUTH_URL=
# Better Auth dashboard project key (better-auth.com) — optional. Powers the
# dash() plugin (cloud dashboard ownership verification + remote admin); must
# be set in the deployed environment for the dashboard to connect.
BETTER_AUTH_API_KEY=
# Social sign-in (each provider activates only when both values are set).
# Callback URLs to register with each provider:
#   GitHub:    ${NEXT_PUBLIC_APP_URL}/api/auth/callback/github
#   Google:    ${NEXT_PUBLIC_APP_URL}/api/auth/callback/google
#   Microsoft: ${NEXT_PUBLIC_APP_URL}/api/auth/callback/microsoft
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
# Entra tenant; "common" allows any Microsoft account.
AUTH_MICROSOFT_TENANT_ID=common
# From-address for verification/reset emails; falls back to WAITLIST_FROM_EMAIL.
AUTH_FROM_EMAIL=
# From-address for failed-payment notices; falls back to WAITLIST_FROM_EMAIL.
BILLING_FROM_EMAIL=

# Build and dev server options (optional).
# Standalone output for the Docker image; the Dockerfile sets it.
# NEXT_OUTPUT=standalone
# Release ID for skew protection on prebuilt deploys (CI sets it per release).
# MOGPLEX_DEPLOYMENT_ID=
# Comma-separated extra origins allowed to reach `next dev`.
# MOGPLEX_ALLOWED_DEV_ORIGINS=
