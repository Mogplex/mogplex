{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/cron/sync-models",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/sandbox-reaper",
      "schedule": "*/5 * * * *"
